# ==============================================================================
# RentMatch AI - Frontend Environment Template (.env.example)
# ==============================================================================
# Copy this file to frontend/.env.local for local overrides.
# For Vercel production: add these 2 variables to Vercel Project Settings.
# ==============================================================================

# API Base URL (FastAPI backend endpoints prefix)
# Local: http://localhost:8000/api/v1
# Production: https://your-backend.railway.app/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Google OAuth 2.0 Web Client ID
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-web-client-id