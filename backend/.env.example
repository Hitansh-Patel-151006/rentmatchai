# ==============================================================================
# RentMatch AI - Backend Environment Template (.env.example)
# ==============================================================================
# Copy this file to backend/.env and replace the placeholders with your values.
# NEVER commit the real backend/.env to version control.
# ==============================================================================

# Database Connection (Supabase Session Pooler or Local PostgreSQL)
# Example Local: postgresql+psycopg2://rentmatch:rentmatch@localhost:5432/rentmatch
# Example Supabase: postgresql+psycopg2://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=postgresql+psycopg2://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Test Database (Used only by pytest - tables are recreated on every run)
TEST_DATABASE_URL=postgresql+psycopg2://rentmatch:rentmatch@localhost:5432/rentmatch_test

# JWT Security Configuration
# Generate a secure key with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins (Comma-separated list of allowed frontend URLs)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://rentmatch.vercel.app

# Google OAuth 2.0 Web Client ID
GOOGLE_CLIENT_ID=your-google-client-id-here
